          "minimum": "8.0.0"
        }
      }
    ]
  },
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "url": "https://github.com/rune-goblin/pf2e-trooper",
  "manifest": "https://github.com/rune-goblin/pf2e-trooper/releases/latest/download/module.json",
